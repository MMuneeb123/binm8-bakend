# =============================================================================
# BinM8 Backend — Environment Variables (template)
# =============================================================================
# This template contains PLACEHOLDERS ONLY — no real credentials, secrets,
# or values of any kind. Copy it to `.env` and replace every <placeholder>
# with a real value:
#   cp .env.example .env
#
# NEVER commit the real .env file. It is git-ignored on purpose.
# The live production values are NOT in this repo — they live on the server at:
#   /var/www/binm8-backend/.env   (and in your own password manager / vault)
#
# Provided as-is for handover/reference. Verify variable names and behaviour
# against app/config/config.js and the running app before relying on this file.
#
# Variables marked (required) must be set or the app will refuse to start
# (see app/config/config.js -> requiredEnvVars). Variables marked (optional)
# fall back to the default shown in [brackets].
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000                                  # (required) Port the API listens on
NODE_ENV=development                        # (required) development | production | test

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost                          # (required) DB host. In Docker Compose this is `postgres`
DB_PORT=5432                               # (required) DB port
DB_NAME=binm8                              # (required) Database name (test run uses <DB_NAME>_test)
DB_USER=<replace-with-db-user>             # (required) DB user
DB_PASSWORD=<replace-with-db-password>     # (required) DB password
# Note: in production, with a non-local host, the app connects over SSL
# (sslmode equivalent: require, rejectUnauthorized=false). See app/models/index.js.

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
JWT_SECRET=<replace-with-strong-random-secret>   # (required) Signing secret for access/refresh tokens
JWT_ACCESS_EXPIRY=1h                        # (optional) [1h] Access token lifetime
JWT_REFRESH_EXPIRY=7d                       # (optional) [7d] Refresh token lifetime

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# (required) Shared token that lets a registration request self-elevate to admin.
ADMIN_REGISTRATION_TOKEN=<replace-with-strong-random-token>

# -----------------------------------------------------------------------------
# Email (Mailtrap API — used for OTP / verification / password reset mail)
# -----------------------------------------------------------------------------
MAILTRAP_API_TOKEN=<replace-with-mailtrap-api-token>   # (optional) Required for outbound email to work
EMAIL_FROM_NAME=BinM8                       # (optional) [BinM8] Display name on outbound mail
EMAIL_FROM_EMAIL=hello@binm8.com            # (optional) [hello@binm8.com] From address on outbound mail

# -----------------------------------------------------------------------------
# Firebase Admin (push notifications via FCM)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=<replace-with-firebase-project-id>      # (optional) Firebase project id
FIREBASE_CLIENT_EMAIL=<replace-with-service-account-email>  # (optional) Service-account client email
# Private key from the service-account JSON. Keep the surrounding quotes and the
# literal \n escapes on one line; the app converts \n back to real newlines.
FIREBASE_PRIVATE_KEY="<replace-with-service-account-private-key>"

# -----------------------------------------------------------------------------
# Error monitoring (Sentry)
# -----------------------------------------------------------------------------
SENTRY_DSN=<replace-with-sentry-dsn>        # (optional) Disable by leaving empty

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info                              # (optional) [info] e.g. error | warn | info | debug
LOG_FILE_PATH=logs/app.log                  # (optional) [logs/app.log] Log file location

# -----------------------------------------------------------------------------
# Misc / testing
# -----------------------------------------------------------------------------
# (optional) When "true", the notification cron uses test timing/behaviour.
# Leave unset/empty in production.
NOTIFICATION_TEST_MODE=
